---
/** Radar triangular de daño (0–3, Nutt et al. 2007). Admite varias series. */
import type { Harm } from '../../../data/types';

interface Serie { name: string; harm: Harm; style: 'solid' | 'hazard' | 'ghost' }
interface Props { series: Serie[] }
const { series } = Astro.props;
const C = 200, R = 140;
const axes = [
  { key: 'physical', label: 'FÍSICO', a: -90 },
  { key: 'dependence', label: 'DEPENDENCIA', a: 30 },
  { key: 'social', label: 'SOCIAL', a: 150 },
] as const;
const pt = (a: number, v: number) => {
  const rad = (a * Math.PI) / 180;
  return [C + Math.cos(rad) * R * (v / 3), C + Math.sin(rad) * R * (v / 3)];
};
const poly = (h: Harm) => axes.map((ax) => pt(ax.a, h[ax.key]).map((n) => n.toFixed(1)).join(',')).join(' ');
---
<figure class="radar">
  <svg viewBox="0 0 400 370" role="img" aria-label={series.map((s) => `${s.name}: físico ${s.harm.physical}, dependencia ${s.harm.dependence}, social ${s.harm.social}`).join('; ')}>
    {[1, 2, 3].map((lv) => <polygon points={axes.map((ax) => pt(ax.a, lv).join(',')).join(' ')} class="grid" />)}
    {axes.map((ax) => {
      const [x, y] = pt(ax.a, 3);
      const [lx, ly] = pt(ax.a, 3.4);
      return (
        <g>
          <line x1={C} y1={C} x2={x} y2={y} class="grid" />
          <text x={lx} y={ly + 4} text-anchor="middle" class="ax">{ax.label}</text>
        </g>
      );
    })}
    {series.map((s) => <polygon points={poly(s.harm)} class={s.style} />)}
  </svg>
  <figcaption>
    {series.map((s) => (
      <span class="lbl"><i class={s.style}></i>{s.name} · {((s.harm.physical + s.harm.dependence + s.harm.social) / 3).toFixed(2)}/3{s.harm.src === 'est' ? ' (est.)' : ''}</span>
    ))}
  </figcaption>
</figure>

<style>
  .radar { margin: 0; }
  svg { width: 100%; max-width: 420px; margin: 0 auto; }
  .grid { fill: none; stroke: var(--line-2); stroke-dasharray: 2 4; }
  .ax { font-family: var(--mono); font-size: 11px; letter-spacing: 2px; fill: var(--mute); }
  polygon.solid { fill: var(--paper); fill-opacity: 0.85; stroke: var(--paper); }
  polygon.hazard { fill: var(--hazard); fill-opacity: 0.55; stroke: var(--hazard); stroke-width: 2; }
  polygon.ghost { fill: none; stroke: var(--paper); stroke-width: 1.5; stroke-dasharray: 6 4; }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 18px; justify-content: center; margin-top: 6px; }
  figcaption i { display: inline-block; width: 18px; height: 8px; margin-right: 6px; vertical-align: middle; }
  i.solid { background: var(--paper); }
  i.hazard { background: var(--hazard); }
  i.ghost { border-top: 1.5px dashed var(--paper); height: 0; }
</style>
