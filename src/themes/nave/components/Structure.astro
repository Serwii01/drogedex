---
import { u } from '../base';
/** Estructura 2D de PubChem (dominio público) tratada como fotocopia. */
interface Props { name: string; query: string }
const { name, query } = Astro.props;
const src = `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/${encodeURIComponent(query)}/PNG?image_size=640x640`;
---
<figure class="xerox tape st-fig">
  <div class="crop"><img src={src} alt={`Estructura química de ${name}`} width="640" height="640" loading="lazy" decoding="async" onerror="this.closest('figure').classList.add('fail')" /></div>
  <figcaption><span class="lbl">Fig. · {query}</span><a class="lbl" href={u(`https://pubchem.ncbi.nlm.nih.gov/#query=${encodeURIComponent(query)}`)} target="_blank" rel="noopener">PubChem ↗</a></figcaption>
</figure>

<style>
  .st-fig { margin: 0; padding: 14px; transform: rotate(0.6deg); }
  .crop { overflow: hidden; aspect-ratio: 1; mix-blend-mode: multiply; }
  img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); filter: grayscale(1) brightness(0.9) contrast(2); }
  figcaption { display: flex; justify-content: space-between; padding-top: 10px; border-top: 1px solid rgba(20, 20, 18, 0.3); }
  .st-fig:global(.fail) img { visibility: hidden; }
</style>
