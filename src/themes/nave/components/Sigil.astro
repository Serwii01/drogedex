---
/** Firma generativa monocroma con trama de semitono. Determinista por slug. */
import { seed, rng } from '../../../lib/rand';

interface Props { slug: string; color: string; label?: string; class?: string }
const { slug, color, label, class: cls } = Astro.props;
const r = rng(seed(slug));
const C = 500;
const ink = '#e8e4d8';

const rings = Array.from({ length: 8 }, (_, i) => ({
  radius: 80 + i * 46 + r() * 12,
  dash: r() < 0.4 ? 'none' : `${Math.round(2 + r() * 30)} ${Math.round(6 + r() * 26)}`,
  w: r() < 0.15 ? 6 : 1.5,
  rot: Math.round(r() * 360),
}));
const bars = Array.from({ length: Math.round(3 + r() * 5) }, () => ({ a: r() * 360, len: 140 + r() * 300, w: 4 + r() * 18 }));
const halfR = 120 + r() * 160;
const ax = C + (r() - 0.5) * 300, ay = C + (r() - 0.5) * 300;
const uid = `s-${slug}`;
---
<svg viewBox="0 0 1000 1000" class={cls} role="img" aria-label={label ?? `Firma de ${slug}`} xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`${uid}-ht`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <circle cx="7" cy="7" r="3.2" fill={color} />
    </pattern>
    <radialGradient id={`${uid}-fade`}>
      <stop offset="0" stop-color="#fff" />
      <stop offset="1" stop-color="#000" />
    </radialGradient>
    <mask id={`${uid}-m`}><circle cx={ax} cy={ay} r={halfR} fill={`url(#${uid}-fade)`} /></mask>
  </defs>
  <rect width="1000" height="1000" fill="#121210" />
  <circle cx={ax} cy={ay} r={halfR} fill={`url(#${uid}-ht)`} mask={`url(#${uid}-m)`} />
  {rings.map((g) => (
    <circle cx={C} cy={C} r={g.radius} fill="none" stroke={ink} stroke-opacity="0.7" stroke-width={g.w} stroke-dasharray={g.dash} transform={`rotate(${g.rot} ${C} ${C})`} />
  ))}
  {bars.map((b) => (
    <rect x={C} y={C - b.w / 2} width={b.len} height={b.w} fill={ink} transform={`rotate(${b.a} ${C} ${C})`} />
  ))}
  <circle cx={C} cy={C} r="34" fill="#121210" stroke={ink} stroke-width="6" />
  <circle cx={C} cy={C} r="10" fill={color} />
</svg>
