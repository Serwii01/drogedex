---
import { comboKeys, risk, riskInfo, note, type Risk } from '../data/interactions';
const cells = comboKeys.map((a) => comboKeys.map((b) => (a.key === b.key ? null : risk(a.key, b.key))));
---
<div class="mx-wrap">
  <div class="legend">
    {(Object.keys(riskInfo) as Risk[]).map((k) => (
      <button class="lg" data-risk={k} style={`--c:${riskInfo[k].color}`} type="button"><i>{riskInfo[k].short}</i>{riskInfo[k].label}</button>
    ))}
  </div>
  <div class="scroller">
    <table class="mx" id="mx">
      <thead>
        <tr><th class="corner"></th>{comboKeys.map((k, j) => <th class="col" data-col={j}><span>{k.label}</span></th>)}</tr>
      </thead>
      <tbody>
        {comboKeys.map((a, i) => (
          <tr>
            <th class="rowh" data-row={i}>{a.label}</th>
            {comboKeys.map((b, j) => {
              const r = cells[i][j];
              if (!r) return <td class="self" data-row={i} data-col={j}></td>;
              return <td data-row={i} data-col={j} data-risk={r} data-a={a.label} data-b={b.label} data-note={note(a.key, b.key) ?? ''} style={`--c:${riskInfo[r].color}`} tabindex="0">{riskInfo[r].short}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <aside class="info xerox tape" id="mx-info" aria-live="polite">
    <span class="lbl">Par seleccionado</span>
    <div class="pair st"><span id="mx-a">—</span><span id="mx-b">—</span></div>
    <div class="verdict" id="mx-v"></div>
    <p id="mx-t">Pasa el cursor o pulsa una casilla.</p>
  </aside>
</div>

<script define:vars={{ riskInfo }}>
  const table = document.getElementById('mx');
  const $ = (id) => document.getElementById(id);
  let locked = null;
  function show(td) {
    if (!td || !td.dataset.risk) return;
    const info = riskInfo[td.dataset.risk];
    $('mx-a').textContent = td.dataset.a;
    $('mx-b').textContent = '+ ' + td.dataset.b;
    $('mx-v').textContent = info.label;
    $('mx-v').style.background = info.color;
    $('mx-t').textContent = td.dataset.note || info.text;
    table.querySelectorAll('.hl').forEach((el) => el.classList.remove('hl'));
    table.querySelectorAll(`[data-row="${td.dataset.row}"], [data-col="${td.dataset.col}"]`).forEach((el) => el.classList.add('hl'));
  }
  table.addEventListener('mouseover', (e) => { if (!locked) show(e.target.closest('td')); });
  table.addEventListener('focusin', (e) => show(e.target.closest('td')));
  table.addEventListener('click', (e) => {
    const td = e.target.closest('td[data-risk]');
    if (!td) return;
    locked?.classList.remove('lock');
    locked = locked === td ? null : td;
    locked?.classList.add('lock');
    show(td);
  });
  document.querySelectorAll('.lg').forEach((b) => b.addEventListener('click', () => {
    const on = b.classList.toggle('on');
    document.querySelectorAll('.lg').forEach((x) => x !== b && x.classList.remove('on'));
    table.querySelectorAll('td[data-risk]').forEach((td) => td.classList.toggle('dim', on && td.dataset.risk !== b.dataset.risk));
  }));
</script>

<style>
  .mx-wrap { display: grid; grid-template-columns: 1fr 290px; gap: 28px; align-items: start; }
  .legend { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; }
  .lg { display: inline-flex; align-items: center; gap: 8px; background: transparent; border: 1px solid var(--line-2); color: var(--paper); font-family: var(--mono); font-size: 11px; padding: 5px 10px 5px 5px; cursor: pointer; }
  .lg i { font-style: normal; background: var(--c); color: var(--ink); font-weight: 500; min-width: 22px; text-align: center; }
  .lg:hover, .lg.on { border-color: var(--c); }
  .scroller { overflow: auto; max-height: 82vh; border: 1px solid var(--line); }
  .mx { border-collapse: collapse; font-size: 10px; background: var(--soot); }
  .mx th { font-weight: 400; color: var(--mute); text-transform: uppercase; letter-spacing: 0.05em; background: var(--soot); }
  .corner { position: sticky; left: 0; top: 0; z-index: 3; }
  .col { position: sticky; top: 0; z-index: 2; height: 116px; vertical-align: bottom; padding: 4px 0; }
  .col span { writing-mode: vertical-rl;  white-space: nowrap; display: inline-block; }
  .rowh { position: sticky; left: 0; z-index: 1; text-align: right; padding: 0 10px; white-space: nowrap; }
  .mx td { width: 34px; min-width: 34px; height: 30px; text-align: center; font-size: 12px; font-weight: 500; color: var(--ink); background: var(--c); border: 1px solid var(--soot); cursor: pointer; }
  .mx td.self { background: repeating-linear-gradient(45deg, var(--concrete), var(--concrete) 3px, var(--soot) 3px, var(--soot) 6px); cursor: default; }
  .mx td:hover, .mx td:focus, .mx td.lock { outline: 2px solid var(--paper); outline-offset: -2px; }
  .mx th.hl { color: var(--hazard); }
  .mx td.dim { opacity: 0.08; }
  .info { position: sticky; top: 90px; padding: 22px 20px;  }
  .pair { font-size: clamp(20px, 4.9vw, 34px); font-weight: 300; display: flex; flex-direction: column; margin: 12px 0; }
  .verdict { display: inline-block; padding: 2px 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 500; margin-bottom: 10px; }
  .info p { margin: 0; font-size: 13px; }
  @media (max-width: 960px) { .mx-wrap { grid-template-columns: 1fr; } .info { position: static; } }
</style>
