---
import '../styles/global.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { substances, pad } from '../data';
import { familyById } from '../data/families';
import { rooms } from '../data/rooms';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Enciclopedia de sustancias psicoactivas con enfoque de reducción de riesgos. Proyecto académico (TFG de Psicología).' } = Astro.props;
const fullTitle = title ? `${title} — DROGEDEX` : 'DROGEDEX — Enciclopedia de sustancias psicoactivas';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// En la barra, las secciones principales; el resto en «Más»
const main = ['/sustancias', '/familias', '/mezclas', '/combinaciones', '/graficos', '/psicologia'];
const nav = main.map((h) => rooms.find((r) => r.href === h)!).filter(Boolean);
const index = [
  ...substances.map((s) => ({ t: s.name, s: `#${pad(s.n)} · ${familyById[s.family].name}`, h: `/sustancias/${s.slug}`, k: [s.name, s.symbol, ...s.aka].join(' ') })),
  ...rooms.map((r) => ({ t: r.label, s: r.sub, h: r.href, k: r.label })),
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090909" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label="Drogedex, inicio">
          <span class="dot"></span>DROGEDEX
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class:list={[{ on: path.startsWith(n.href) }]}>{n.label}</a>
          ))}
          <button id="open-menu" type="button" aria-expanded="false" aria-controls="menu">Más +</button>
        </nav>
        <div class="acts">
          <button class="ib" id="open-search" type="button" aria-label="Buscar (tecla /)"><span>Buscar</span><kbd>/</kbd></button>
          <a class="ib sos" href="/emergencias" title="Qué hacer en una emergencia">112</a>
        </div>
      </div>
    </header>

    <div class="overlay" id="menu" hidden>
      <div class="wrap">
        <div class="ov-top">
          <span class="label">// Secciones · {rooms.length}</span>
          <button class="ib" data-close type="button">Cerrar ✕</button>
        </div>
        <ol class="rooms">
          {rooms.map((r, i) => (
            <li class:list={[{ on: path.startsWith(r.href) }]}>
              <a href={r.href}>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">{r.label}</span>
                <span class="s">{r.sub}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="overlay" id="search" hidden>
      <div class="wrap">
        <div class="ov-top">
          <span class="label">// Buscar en Drogedex</span>
          <button class="ib" data-close type="button">Esc ✕</button>
        </div>
        <input id="sq" type="search" placeholder="sustancia, apodo, sección…" autocomplete="off" />
        <ul id="sr" class="results"></ul>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="warn">
          <span class="label red">// Aviso</span>
          <p>
            Drogedex es un proyecto académico con fines educativos y de reducción de riesgos. No promueve el consumo de ninguna sustancia.
            La información puede contener errores y no sustituye el consejo médico. Ante una emergencia llama al <strong>112</strong>.
            Información y análisis de sustancias en España: <a href="https://energycontrol-international.org" target="_blank" rel="noopener">Energy Control</a>.
          </p>
        </div>
        <div class="row">
          <span class="label">© {new Date().getFullYear()} DROGEDEX — TFG Psicología</span>
          <span class="label">Hecho en la oscuridad · 128 BPM</span>
        </div>
      </div>
    </footer>

    <ThemeSwitch actual="original" />

    <script is:inline define:vars={{ index }}>
      const $ = (id) => document.getElementById(id);
      const menu = $('menu'), search = $('search'), sq = $('sq'), sr = $('sr');
      const norm = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
      function open(el) { close(); el.hidden = false; document.body.style.overflow = 'hidden'; if (el === search) { sq.value = ''; render(''); setTimeout(() => sq.focus(), 0); } $('open-menu').setAttribute('aria-expanded', String(el === menu)); }
      function close() { menu.hidden = true; search.hidden = true; document.body.style.overflow = ''; $('open-menu').setAttribute('aria-expanded', 'false'); }
      function render(q) {
        const n = norm(q.trim());
        const hits = (n ? index.filter((x) => norm(x.k + ' ' + x.t).includes(n)) : index.slice(-13)).slice(0, 12);
        sr.innerHTML = hits.map((x, i) => `<li><a href="${x.h}" ${i === 0 ? 'class="first"' : ''}><b>${x.t}</b><span>${x.s}</span></a></li>`).join('') || '<li class="none">Sin resultados.</li>';
      }
      $('open-menu').onclick = () => (menu.hidden ? open(menu) : close());
      $('open-search').onclick = () => open(search);
      document.querySelectorAll('[data-close]').forEach((b) => (b.onclick = close));
      sq.addEventListener('input', () => render(sq.value));
      sq.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const a = sr.querySelector('a'); if (a) location.href = a.href; } });
      document.addEventListener('keydown', (e) => {
        const typing = /input|textarea|select/i.test(document.activeElement?.tagName || '');
        if (e.key === 'Escape') close();
        else if (e.key === '/' && !typing) { e.preventDefault(); open(search); }
      });
    </script>

    <style>
      .top {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(9, 9, 9, 0.86);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .bar { display: flex; align-items: center; gap: 32px; height: 56px; }
      .logo {
        font-family: var(--display);
        font-weight: 900;
        font-stretch: 125%;
        font-size: 18px;
        letter-spacing: 0.02em;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .dot { width: 10px; height: 10px; background: var(--acid); border-radius: 50%; box-shadow: 0 0 12px var(--acid); }
      nav { display: flex; gap: 22px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; align-items: center; }
      nav a, nav button { color: var(--mute); padding: 4px 0; border: 0; border-bottom: 1px solid transparent; background: none; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; white-space: nowrap; }
      nav a:hover, nav a.on, nav button:hover { color: var(--fg); border-color: var(--acid); }
      .acts { margin-left: auto; display: flex; gap: 6px; }
      .ib { background: transparent; border: 1px solid var(--line-2); color: var(--fg); font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 10px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
      .ib:hover { border-color: var(--acid); color: var(--acid); }
      .ib kbd { font-family: var(--mono); border: 1px solid var(--line-2); padding: 0 5px; color: var(--mute); }
      .sos { border-color: var(--red); color: var(--red); font-weight: 700; }
      .sos:hover { background: var(--red); color: #000; border-color: var(--red); }
      @media (max-width: 1100px) { nav a:nth-child(n + 4) { display: none; } }
      @media (max-width: 720px) {
        .bar { gap: 14px; }
        nav { gap: 14px; }
        nav a { display: none; }
        .ib span { display: none; }
      }

      .overlay { position: fixed; inset: 0; z-index: 80; background: rgba(9, 9, 9, 0.97); overflow-y: auto; padding: 24px 0 80px; }
      .ov-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
      .rooms { list-style: none; padding: 0; margin: 0; }
      .rooms a { display: grid; grid-template-columns: 60px 1fr auto; gap: 16px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--line); }
      .rooms .n { font-size: 11px; color: var(--acid); letter-spacing: 0.12em; }
      .rooms .t { font-family: var(--display); font-weight: 900; font-stretch: 125%; text-transform: uppercase; font-size: clamp(30px, 5vw, 60px); line-height: 0.95; }
      .rooms .s { font-size: 11px; color: var(--mute); text-transform: uppercase; letter-spacing: 0.1em; text-align: right; }
      .rooms a:hover .t, .rooms .on .t { color: var(--acid); }
      @media (max-width: 640px) { .rooms a { grid-template-columns: 40px 1fr; } .rooms .s { display: none; } }

      #sq { width: 100%; background: transparent; border: 0; border-bottom: 2px solid var(--fg); color: var(--fg); font-family: var(--display); font-weight: 900; font-stretch: 125%; font-size: clamp(30px, 6vw, 64px); text-transform: uppercase; padding: 8px 0; outline: none; }
      #sq:focus { border-color: var(--acid); }
      .results { list-style: none; padding: 0; margin: 20px 0 0; }
      .results :global(a) { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .results :global(b) { font-weight: 500; font-size: 16px; }
      .results :global(span) { color: var(--mute); font-size: 12px; }
      .results :global(a:hover b), .results :global(a.first b) { color: var(--acid); }
      .results :global(.none) { color: var(--mute); padding: 12px 0; }

      .foot { border-top: 1px solid var(--line); padding: 48px 0 72px; margin-top: 0; }
      .warn { display: grid; grid-template-columns: 120px 1fr; gap: 24px; margin-bottom: 40px; }
      .warn p { margin: 0; color: var(--mute); max-width: 80ch; }
      .warn a { color: var(--acid); text-decoration: underline; }
      .row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
      @media (max-width: 720px) { .warn { grid-template-columns: 1fr; gap: 8px; } }
    </style>
  </body>
</html>
