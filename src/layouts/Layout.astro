---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Enciclopedia de sustancias psicoactivas con enfoque de reducción de riesgos. Proyecto académico (TFG de Psicología).' } = Astro.props;
const fullTitle = title ? `${title} — DROGEDEX` : 'DROGEDEX — Enciclopedia de sustancias psicoactivas';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/sustancias', label: 'Índice' },
  { href: '/familias', label: 'Familias' },
  { href: '/combinaciones', label: 'Combinaciones' },
  { href: '/graficos', label: 'Datos' },
  { href: '/metodologia', label: 'Método' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090909" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label="Drogedex, inicio">
          <span class="dot"></span>DROGEDEX
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class:list={[{ on: path.startsWith(n.href) }]}>{n.label}</a>
          ))}
        </nav>
        <span class="label status">SYS/ONLINE<span class="blink">_</span></span>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="warn">
          <span class="label red">// Aviso</span>
          <p>
            Drogedex es un proyecto académico con fines educativos y de reducción de riesgos. No promueve el consumo de ninguna sustancia.
            La información puede contener errores y no sustituye el consejo médico. Ante una emergencia llama al <strong>112</strong>.
            Información y análisis de sustancias en España: <a href="https://energycontrol-international.org" target="_blank" rel="noopener">Energy Control</a>.
          </p>
        </div>
        <div class="row">
          <span class="label">© {new Date().getFullYear()} DROGEDEX — TFG Psicología</span>
          <span class="label">Hecho en la oscuridad · 128 BPM</span>
        </div>
      </div>
    </footer>

    <style>
      .top {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(9, 9, 9, 0.86);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .bar { display: flex; align-items: center; gap: 32px; height: 56px; }
      .logo {
        font-family: var(--display);
        font-weight: 900;
        font-stretch: 125%;
        font-size: 18px;
        letter-spacing: 0.02em;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .dot { width: 10px; height: 10px; background: var(--acid); border-radius: 50%; box-shadow: 0 0 12px var(--acid); }
      nav { display: flex; gap: 24px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; }
      nav a { color: var(--mute); padding: 4px 0; border-bottom: 1px solid transparent; }
      nav a:hover, nav a.on { color: var(--fg); border-color: var(--acid); }
      .status { margin-left: auto; }
      @media (max-width: 860px) {
        .status { display: none; }
        .bar { gap: 16px; }
        nav { gap: 14px; overflow-x: auto; scrollbar-width: none; }
        nav a { white-space: nowrap; font-size: 11px; }
      }
      @media (max-width: 520px) {
        .bar { flex-direction: column; align-items: flex-start; height: auto; padding-top: 10px; padding-bottom: 8px; gap: 6px; }
        nav { width: 100%; }
      }
      .foot { border-top: 1px solid var(--line); padding: 48px 0 32px; margin-top: 0; }
      .warn { display: grid; grid-template-columns: 120px 1fr; gap: 24px; margin-bottom: 40px; }
      .warn p { margin: 0; color: var(--mute); max-width: 80ch; }
      .warn a { color: var(--acid); text-decoration: underline; }
      .row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
      @media (max-width: 720px) { .warn { grid-template-columns: 1fr; gap: 8px; } }
    </style>
  </body>
</html>
