---
import Layout from '../../themes/nave/layouts/Layout.astro';
import { substances } from '../../data';

const est = substances.filter((s) => s.harm.src === 'est').length;
const refs = [
  'American Psychiatric Association. (2013). Diagnostic and statistical manual of mental disorders (5.ª ed.). APA.',
  'Engel, G. L. (1977). The need for a new medical model: A challenge for biomedicine. Science, 196(4286), 129–136.',
  'Gable, R. S. (2004). Comparison of acute lethal toxicity of commonly abused psychoactive substances. Addiction, 99(6), 686–696.',
  'Koob, G. F., & Volkow, N. D. (2010). Neurocircuitry of addiction. Neuropsychopharmacology, 35(1), 217–238.',
  'Koob, G. F., & Volkow, N. D. (2016). Neurobiology of addiction: A neurocircuitry analysis. The Lancet Psychiatry, 3(8), 760–773.',
  'Marlatt, G. A., & Gordon, J. R. (Eds.). (1985). Relapse prevention. Guilford Press.',
  'Miller, W. R., & Rollnick, S. (1991). Motivational interviewing. Guilford Press.',
  'Nutt, D., King, L. A., Saulsbury, W., & Blakemore, C. (2007). Development of a rational scale to assess the harm of drugs of potential misuse. The Lancet, 369(9566), 1047–1053.',
  'Nutt, D. J., King, L. A., & Phillips, L. D. (2010). Drug harms in the UK: A multicriteria decision analysis. The Lancet, 376(9752), 1558–1565.',
  'Prochaska, J. O., & DiClemente, C. C. (1982). Transtheoretical therapy: Toward a more integrative model of change. Psychotherapy: Theory, Research & Practice, 19(3), 276–288.',
  'Delegación del Gobierno para el Plan Nacional sobre Drogas. (2023). EDADES 2022. Ministerio de Sanidad.',
  'European Union Drugs Agency. (2024). European Drug Report 2024.',
  'UNODC. (2024). World Drug Report 2024. United Nations.',
  'CDC / NCHS. (2023). Drug overdose deaths in the United States, 2002–2022 (Data Brief n.º 491).',
  'TripSit. (2023). Drug combinations chart (v3).',
];
---
<Layout title="Metodología" description="Fuentes, criterios y limitaciones.">
  <section class="wrap top">
    <p class="lbl">Sala 12 · método</p>
    <h1>Método</h1>
  </section>
  <section class="block">
    <div class="wrap two">
      <div>
        <p class="lbl">Criterios</p>
        <ul class="dash">
          <li>Clasificación farmacológica por efecto predominante y diana molecular.</li>
          <li>Daño: escala 0–3 de Nutt et al. (2007). {substances.length - est} valores publicados, {est} estimaciones editoriales señaladas.</li>
          <li>Combinaciones: adaptadas de TripSit y agrupadas por clase.</li>
          <li>Precios: estimaciones orientativas en euros, no datos oficiales comparables.</li>
          <li>Duraciones: rangos típicos; varían con dosis, vía y tolerancia.</li>
          <li>Fotografías: Wikimedia Commons (dominio público, CC0 y Creative Commons); autor y licencia en cada ficha y en la galería.</li>
          <li>Estructuras: PubChem (dominio público). Firmas generativas propias.</li>
        </ul>
      </div>
      <div>
        <p class="lbl">Límites</p>
        <ul class="dash">
          <li>No incluye dosis: no es una guía de consumo.</li>
          <li>Los datos del mercado ilícito son imprecisos por naturaleza.</li>
          <li>El checklist DSM-5 es didáctico, no diagnóstico.</li>
          <li>La legislación cambia: comprobar fechas.</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <div class="head"><span class="lbl">Bibliografía</span><div><h2>Referencias</h2></div></div>
      <ol class="refs">{refs.map((r) => <li>{r}</li>)}</ol>
    </div>
  </section>
</Layout>

<style>
  .top { padding-top: 56px; padding-bottom: 32px; }
  h1 { margin: 10px 0 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
  .refs { margin: 0; padding-left: 28px; max-width: 100ch; }
  .refs li { padding: 10px 0 10px 8px; border-bottom: 1px dashed var(--line-2); color: var(--mute); padding-left: 2.2em; text-indent: -2.2em; }
  .refs li::marker { color: var(--hazard); }
</style>
