---
import Layout from '../../themes/nave/layouts/Layout.astro';
import WorldDots from '../../themes/nave/components/WorldDots.astro';
import { routes } from '../../data/extra';
import { countries } from '../../data';
---
<Layout title="Mapa" description="Mapa mundial de precios estimados y rutas del tráfico de drogas.">
  <section class="wrap top">
    <p class="lbl">Sala 07 · geografía</p>
    <h1>Mapa</h1>
    <p class="mute intro">Precios estimados por país y principales rutas desde las zonas de producción hasta los mercados de consumo. Cuanto más lejos del origen, más sube el precio: cada frontera y cada intermediario añaden riesgo y margen.</p>
  </section>
  <section class="wrap"><WorldDots /></section>
  <section class="block">
    <div class="wrap">
      <div class="head"><span class="lbl">Rutas</span><div><h2>Origen → destino</h2></div></div>
      <table class="data">
        <tbody>
          {routes.map((r) => <tr><th>{r.name}</th><td><b class="hz">{r.from.map((c) => countries[c]).join(', ')}</b> → {r.to.map((c) => countries[c]).join(', ')}</td></tr>)}
        </tbody>
      </table>
      <p class="mute small">Simplificación divulgativa basada en el World Drug Report (UNODC) y el European Drug Report (EUDA). Las rutas reales son múltiples y cambiantes (p. ej., África occidental como zona de tránsito de la cocaína hacia Europa).</p>
    </div>
  </section>
</Layout>

<style>
  .top { padding-top: 56px; padding-bottom: 32px; }
  h1 { margin: 10px 0 18px; }
  .intro { max-width: 70ch; }
  .small { font-size: 12px; margin-top: 18px; max-width: 80ch; }
  b { font-weight: 500; }
</style>
