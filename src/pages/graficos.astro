---
import Layout from '../layouts/Layout.astro';
import BarChart from '../components/BarChart.astro';
import Scatter from '../components/Scatter.astro';
import Timeline from '../components/Timeline.astro';
import { substances, bySlug, countries } from '../data';
import { familyById } from '../data/families';
import { nutt2010, unodcUsers, edades2022, cdc2022, gable } from '../data/stats';

const colorOf = (slug: string) => familyById[bySlug[slug].family].color;

const gablePts = gable.map((g) => ({ name: g.name, x: g.safety, y: g.dep, color: colorOf(g.slug), href: `/sustancias/${g.slug}` }));
const nuttPts = substances.map((s) => ({
  name: s.name,
  x: s.harm.dependence,
  y: s.harm.physical,
  color: familyById[s.family].color,
  href: `/sustancias/${s.slug}`,
}));
const durRows = substances
  .filter((s) => s.duration)
  .sort((a, b) => a.duration!.total - b.duration!.total)
  .map((s) => ({ name: s.name, d: s.duration!, color: familyById[s.family].color, href: `/sustancias/${s.slug}` }));

const coke = bySlug['cocaina'].prices.map((p) => ({ name: countries[p.c], v: p.v })).sort((a, b) => b.v - a.v);
const mdma = bySlug['mdma'].prices.map((p) => ({ name: countries[p.c], v: p.v })).sort((a, b) => b.v - a.v);
const cann = bySlug['cannabis'].prices.map((p) => ({ name: countries[p.c], v: p.v })).sort((a, b) => b.v - a.v);
---
<Layout title="Datos y gráficos" description="Gráficos sobre daño, prevalencia, mortalidad, duración y precios de las drogas.">
  <section class="wrap head">
    <span class="label">Datos / 08 gráficos</span>
    <h1>Datos</h1>
    <p class="lede">Visualizaciones a partir de fuentes científicas y epidemiológicas. Útiles como material de apoyo para el marco teórico y la discusión del TFG. Cita siempre la fuente original.</p>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="idx">01 / DAÑO GLOBAL</span><div><h2>Ranking de daño</h2><p>Puntuación global de daño (0–100) combinando 16 criterios de daño a la persona consumidora y a terceros. Nutt, King &amp; Phillips, <i>The Lancet</i>, 2010.</p></div></div>
      <BarChart rows={nutt2010} max={100} color="var(--red)" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="idx">02 / TOXICIDAD VS. ADICCIÓN</span><div><h2>Margen de seguridad</h2><p>Margen de seguridad (cuántas veces la dosis activa habitual se necesitaría para una dosis letal, escala logarítmica) frente al potencial de dependencia. Posiciones aproximadas basadas en Gable (2004, 2006).</p></div></div>
      <Scatter
        pts={gablePts}
        xLabel="Margen de seguridad (dosis letal / dosis activa) →"
        yLabel="Potencial de dependencia →"
        xLog xMin={3} xMax={2000}
        xTicks={[5, 10, 20, 50, 100, 200, 500, 1000]}
        yTicks={[0, 1, 2, 3, 4, 5]}
        yMax={5}
        quadrants={['TÓXICAS Y ADICTIVAS', 'SEGURAS PERO ADICTIVAS', 'TÓXICAS, POCO ADICTIVAS', 'BAJO RIESGO RELATIVO']}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="idx">03 / PERFIL DE DAÑO</span><div><h2>Físico vs. dependencia</h2><p>Todas las sustancias de Drogedex en la escala 0–3 de Nutt et al. (2007). Valores publicados para 17 sustancias y estimaciones editoriales con la misma escala para el resto.</p></div></div>
      <Scatter
        pts={nuttPts}
        xLabel="Dependencia (0–3) →"
        yLabel="Daño físico (0–3) →"
        xMin={0} xMax={3} yMax={3}
        xTicks={[0, 0.5, 1, 1.5, 2, 2.5, 3]}
        yTicks={[0, 0.5, 1, 1.5, 2, 2.5, 3]}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <div class="section-head col"><span class="idx">04 / MUNDO</span><div><h2>Consumidores</h2><p>Personas que consumieron en el último año (millones), 2022. UNODC, <i>World Drug Report</i> 2024.</p></div></div>
        <BarChart rows={unodcUsers} unit="M" />
      </div>
      <div>
        <div class="section-head col"><span class="idx">05 / ESPAÑA</span><div><h2>Prevalencia</h2><p>Consumo en los últimos 12 meses, población de 15–64 años (%). Encuesta EDADES 2022, Plan Nacional sobre Drogas.</p></div></div>
        <BarChart rows={edades2022} unit="%" decimals={1} max={100} color="#4d7cff" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="idx">06 / MORTALIDAD</span><div><h2>Sobredosis en EE. UU.</h2><p>Muertes por sobredosis en 2022 según la sustancia implicada (una muerte puede implicar varias sustancias). CDC / NCHS.</p></div></div>
      <BarChart rows={cdc2022} color="var(--red)" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="idx">07 / TIEMPO</span><div><h2>Duración comparada</h2><p>Curva típica de efectos de todas las sustancias, de la más breve a la más larga (escala logarítmica).</p></div></div>
      <Timeline log rows={durRows} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="idx">08 / MERCADO</span><div><h2>Precios por país</h2><p>Estimaciones orientativas en euros. Cuanto más lejos del país productor, mayor precio.</p></div></div>
      <div class="three">
        <div><h3>Cocaína · €/g</h3><BarChart rows={coke} unit="€" color="#d4ff3a" /></div>
        <div><h3>MDMA · €/pastilla</h3><BarChart rows={mdma} unit="€" color="#ff2fb4" /></div>
        <div><h3>Cannabis · €/g</h3><BarChart rows={cann} unit="€" decimals={1} color="#2bff88" /></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .head { padding-top: 56px; padding-bottom: 32px; }
  h1 { font-size: clamp(56px, 11vw, 160px); margin: 12px 0 24px; }
  .lede { max-width: 72ch; color: var(--mute); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .section-head.col { grid-template-columns: 1fr; gap: 8px; }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .three h3 { margin-bottom: 16px; }
  .three :global(.row) { grid-template-columns: 100px 1fr 50px; }
  @media (max-width: 960px) { .two, .three { grid-template-columns: 1fr; } }
</style>
