---
/**
 * Selector de diseño: lleva a la misma página en Original, Nave u Hormigón.
 * Lo usan los tres layouts; su estilo es neutro para encajar en los tres.
 */
import { disenos, rutaEnDiseno, type DisenoId } from '../data/disenos';

interface Props { actual: DisenoId }
const { actual } = Astro.props;
const path = Astro.url.pathname;
const links = disenos.map((d) => ({ ...d, href: rutaEnDiseno(path, d.base) }));
---
<nav class="dx-switch" aria-label="Cambiar de diseño">
  <span class="dx-l">Diseño</span>
  {links.map((l) => (
    <a href={l.href} data-diseno={l.id} title={l.desc} class:list={[{ 'dx-on': l.id === actual }]} aria-current={l.id === actual ? 'page' : undefined}>
      {l.nombre}
    </a>
  ))}
</nav>

<script>
  // Al cambiar de diseño se conservan los parámetros (p. ej. ?a=lsd&b=mdma en Comparar) y el ancla
  document.querySelectorAll<HTMLAnchorElement>('.dx-switch a').forEach((a) => {
    a.addEventListener('click', () => {
      a.href = a.pathname + location.search + location.hash;
    });
  });
</script>

<style>
  .dx-switch {
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: rgba(10, 10, 10, 0.88);
    color: #f2f0ea;
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
    font: 500 11px/1 ui-monospace, 'JetBrains Mono', 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dx-l { padding: 0 8px 0 6px; opacity: 0.6; }
  .dx-switch a { padding: 7px 10px; color: inherit; text-decoration: none; border: 0; }
  .dx-switch a:hover { background: rgba(255, 255, 255, 0.12); }
  .dx-switch a.dx-on { background: #f2f0ea; color: #0a0a0a; }
  @media (max-width: 520px) { .dx-l { display: none; } .dx-switch { left: 8px; bottom: 8px; } }
  @media print { .dx-switch { display: none; } }
</style>
