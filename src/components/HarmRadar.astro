---
/** Radar triangular de daño (escala 0–3 de Nutt et al., 2007). */
import type { Harm } from '../data/types';

interface Props { harm: Harm; color: string; compare?: { name: string; harm: Harm } }
const { harm, color, compare: ref } = Astro.props;
const C = 200, R = 150;
const axes = [
  { key: 'physical', label: 'DAÑO FÍSICO', a: -90 },
  { key: 'dependence', label: 'DEPENDENCIA', a: 30 },
  { key: 'social', label: 'DAÑO SOCIAL', a: 150 },
] as const;
const pt = (a: number, v: number) => {
  const rad = (a * Math.PI) / 180;
  return [C + Math.cos(rad) * R * (v / 3), C + Math.sin(rad) * R * (v / 3)];
};
const poly = (h: Harm) => axes.map((ax) => pt(ax.a, h[ax.key]).map((n) => n.toFixed(1)).join(',')).join(' ');
const mean = ((harm.physical + harm.dependence + harm.social) / 3).toFixed(2);
---
<div class="radar">
  <svg viewBox="0 0 400 380" role="img" aria-label={`Perfil de daño: físico ${harm.physical}, dependencia ${harm.dependence}, social ${harm.social} sobre 3`}>
    {[1, 2, 3].map((lv) => (
      <polygon points={axes.map((ax) => pt(ax.a, lv).join(',')).join(' ')} fill="none" stroke="#333" stroke-dasharray={lv === 3 ? 'none' : '3 4'} />
    ))}
    {axes.map((ax) => {
      const [x, y] = pt(ax.a, 3);
      const [lx, ly] = pt(ax.a, 3.45);
      return (
        <g>
          <line x1={C} y1={C} x2={x} y2={y} stroke="#333" />
          <text x={lx} y={ly + 4} text-anchor="middle" font-size="11" fill="#8b8b86" font-family="JetBrains Mono" letter-spacing="1.5">{ax.label}</text>
          <text x={lx} y={ly + 20} text-anchor="middle" font-size="13" fill="#e9e9e4" font-family="JetBrains Mono">{harm[ax.key].toFixed(2)}</text>
        </g>
      );
    })}
    {ref && <polygon points={poly(ref.harm)} fill="none" stroke="#e9e9e4" stroke-opacity="0.5" stroke-dasharray="5 4" />}
    <polygon points={poly(harm)} fill={color} fill-opacity="0.22" stroke={color} stroke-width="2" />
    {axes.map((ax) => { const [x, y] = pt(ax.a, harm[ax.key]); return <rect x={x - 4} y={y - 4} width="8" height="8" fill={color} />; })}
  </svg>
  <div class="foot">
    <span class="label">Media <b>{mean}</b> / 3</span>
    {ref && <span class="label"><i class="ref"></i> Referencia: {ref.name}</span>}
    <span class="label">{harm.src === 'nutt2007' ? 'Fuente: Nutt et al. (2007)' : 'Estimación editorial (escala Nutt 2007)'}</span>
  </div>
</div>

<style>
  .radar svg { width: 100%; max-width: 440px; margin: 0 auto; }
  .foot { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: center; margin-top: 8px; }
  .foot b { color: var(--fg); font-weight: 500; }
  .ref { display: inline-block; width: 18px; border-top: 1px dashed var(--fg); vertical-align: middle; margin-right: 4px; }
</style>
