---
/**
 * Triángulo de efectos: estimulante / depresor / alucinógeno.
 * Coordenadas baricéntricas a partir de los pesos de cada familia.
 */
import { families } from '../data/families';

const A = { x: 450, y: 50 }; // alucinógeno
const B = { x: 70, y: 690 }; // estimulante
const C = { x: 830, y: 690 }; // depresor
const place = (w: { stim: number; dep: number; hal: number }) => {
  const s = w.stim + w.dep + w.hal;
  return {
    x: (A.x * w.hal + B.x * w.stim + C.x * w.dep) / s,
    y: (A.y * w.hal + B.y * w.stim + C.y * w.dep) / s,
  };
};
---
<figure class="wheel">
  <svg viewBox="0 0 900 760" role="img" aria-label="Triángulo de efectos de las familias de sustancias">
    {[0.25, 0.5, 0.75].map((t) => (
      <polygon
        points={[A, B, C].map((p) => `${450 + (p.x - 450) * t},${477 + (p.y - 477) * t}`).join(' ')}
        fill="none" stroke="#242424" stroke-dasharray="4 6"
      />
    ))}
    <polygon points={`${A.x},${A.y} ${B.x},${B.y} ${C.x},${C.y}`} fill="none" stroke="#e9e9e4" stroke-width="1.5" />
    <text x={A.x} y={A.y - 18} text-anchor="middle" class="ax">ALUCINÓGENO</text>
    <text x={B.x} y={B.y + 40} text-anchor="start" class="ax">ESTIMULANTE</text>
    <text x={C.x} y={C.y + 40} text-anchor="end" class="ax">DEPRESOR</text>

    {families.map((f) => {
      const p = place(f.wheel);
      return (
        <a href={`/familias/${f.id}`}>
          <g class="node">
            <circle cx={p.x} cy={p.y} r="34" fill="#0b0b0b" stroke={f.color} stroke-width="2" />
            <circle cx={p.x} cy={p.y} r="34" fill={f.color} fill-opacity="0.12" />
            <text x={p.x} y={p.y + 6} text-anchor="middle" class="code" fill={f.color}>{f.code}</text>
            <text x={p.x} y={p.y + 56} text-anchor="middle" class="nm">{f.name.toUpperCase()}</text>
          </g>
        </a>
      );
    })}
  </svg>
</figure>

<style>
  .wheel { margin: 0; }
  svg { width: 100%; height: auto; max-width: 820px; margin: 0 auto; }
  .ax { font-family: 'Archivo', sans-serif; font-weight: 900; font-stretch: 125%; font-size: 22px; fill: #e9e9e4; letter-spacing: 1px; }
  .code { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 18px; }
  .nm { font-family: 'JetBrains Mono', monospace; font-size: 12px; fill: #8b8b86; letter-spacing: 1.5px; }
  .node { cursor: pointer; transition: opacity 0.2s; }
  .node:hover .nm { fill: #d4ff3a; }
  .node:hover circle:first-child { stroke-width: 4; }
</style>
