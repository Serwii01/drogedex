---
/**
 * Mapa mundial de puntos calculado en build (Natural Earth 110m vía world-atlas).
 * Capas: precios por sustancia (círculos) y rutas de tráfico (arcos).
 */
import { geoContains } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
import { geo, routes } from '../data/extra';
import { bySlug, countries } from '../data';

const land = feature(land110 as any, (land110 as any).objects.land) as any;
const W = 1000, LAT0 = 82, LAT1 = -58;
const H = Math.round((W * (LAT0 - LAT1)) / 360);
const X = (lon: number) => ((lon + 180) / 360) * W;
const Y = (lat: number) => ((LAT0 - lat) / (LAT0 - LAT1)) * H;
const STEP = 2.5;
const dots: [number, number][] = [];
for (let lat = LAT0 - STEP / 2; lat > LAT1; lat -= STEP) {
  for (let lon = -180 + STEP / 2; lon < 180; lon += STEP) {
    if (geoContains(land, [lon, lat])) dots.push([X(lon), Y(lat)]);
  }
}

const layers = ['cocaina', 'mdma', 'cannabis', 'heroina', 'anfetamina'].map((slug) => {
  const s = bySlug[slug];
  const max = Math.max(...s.prices.map((p) => p.v));
  const placed: { x: number; y: number }[] = [];
  const pts = s.prices.filter((p) => geo[p.c]).map((p) => ({
    x: X(geo[p.c][1]), y: Y(geo[p.c][0]), v: p.v, r: 6 + Math.sqrt(p.v / max) * 26, c: countries[p.c],
  })).sort((a, b) => a.y - b.y).map((p) => {
    let lx = p.x + p.r + 4;
    let ly = p.y + 4;
    for (let k = 0; k < 10 && placed.some((q) => Math.abs(q.y - ly) < 13 && Math.abs(q.x - lx) < 130); k++) ly += 13;
    placed.push({ x: lx, y: ly });
    return { ...p, lx, ly };
  });
  return {
    slug,
    name: s.name,
    unit: s.prices[0]?.unit,
    pts,
  };
});

const arcs = routes.map((rt) => ({
  name: rt.name,
  paths: rt.from.flatMap((f) => rt.to.map((t) => {
    const x1 = X(geo[f][1]), y1 = Y(geo[f][0]), x2 = X(geo[t][1]), y2 = Y(geo[t][0]);
    const mx = (x1 + x2) / 2, my = (y1 + y2) / 2 - Math.hypot(x2 - x1, y2 - y1) * 0.25;
    return { d: `M${x1.toFixed(1)} ${y1.toFixed(1)} Q${mx.toFixed(1)} ${my.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`, x1, y1 };
  })),
}));
---
<div class="world">
  <div class="ctrl" role="tablist" aria-label="Capa del mapa">
    {layers.map((l, i) => <button type="button" class:list={['tab', { on: i === 0 }]} data-layer={`p-${l.slug}`}>{l.name}</button>)}
    <button type="button" class="tab" data-layer="routes">Rutas</button>
  </div>
  <div class="frame">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mapa mundial de precios y rutas">
      <g class="land">{dots.map(([x, y]) => <rect x={x - 1.3} y={y - 1.3} width="2.6" height="2.6" />)}</g>
      {layers.map((l, i) => (
        <g class="layer" id={`p-${l.slug}`} data-on={i === 0 ? '1' : '0'}>
          {l.pts.map((p) => (
            <g class="pp">
              <circle cx={p.x} cy={p.y} r={p.r} />
              <circle cx={p.x} cy={p.y} r="2.5" class="core" />
              {Math.abs(p.ly - 4 - p.y) > 2 && <line x1={p.x} y1={p.y} x2={p.lx - 2} y2={p.ly - 4} class="ld" />}
              <text x={p.lx} y={p.ly}>{p.c} · {p.v.toLocaleString('es-ES')} €</text>
            </g>
          ))}
        </g>
      ))}
      <g class="layer" id="routes" data-on="0">
        {arcs.map((a) => (
          <g class="rt">
            {a.paths.map((p) => <g><path d={p.d} /><circle cx={p.x1} cy={p.y1} r="5" /></g>)}
          </g>
        ))}
      </g>
    </svg>
  </div>
  <div class="cap">
    {layers.map((l, i) => <p class="label" data-cap={`p-${l.slug}`} hidden={i !== 0}>Precio estimado en € · unidad: {l.unit} · tamaño ∝ precio</p>)}
    <p class="label" data-cap="routes" hidden>Rutas principales: {routes.map((r) => r.name).join(' · ')} · origen = punto sólido</p>
  </div>
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.world .tab');
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => x.classList.toggle('on', x === t));
    document.querySelectorAll<SVGGElement>('.world .layer').forEach((g) => (g.dataset.on = g.id === t.dataset.layer ? '1' : '0'));
    document.querySelectorAll<HTMLElement>('.world [data-cap]').forEach((p) => (p.hidden = p.dataset.cap !== t.dataset.layer));
  }));
</script>

<style>
  .ctrl { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .tab { background: transparent; border: 1px solid var(--line-2); color: var(--mute); font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; padding: 7px 12px; cursor: pointer; }
  .tab:hover { color: var(--fg); border-color: var(--fg); }
  .tab.on { background: var(--fg); color: #000; border-color: var(--fg); }
  .frame { overflow-x: auto; }
  svg { width: 100%; min-width: 640px; height: auto; }
  .land rect { fill: var(--line-2); }
  .layer[data-on='0'] { display: none; }
  .pp circle { fill: var(--acid); fill-opacity: 0.22; stroke: var(--acid); stroke-width: 1.5; }
  .pp .core { fill: var(--acid); fill-opacity: 1; stroke: none; }
  .pp text { font-family: var(--mono); font-size: 11px; fill: var(--fg); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; }
  .ld { stroke: var(--mute); stroke-width: 0.8; }
  .rt path { fill: none; stroke: var(--acid); stroke-width: 1.4; stroke-opacity: 0.8; stroke-dasharray: 5 4; }
  .rt circle { fill: var(--fg); }
  .cap { margin-top: 10px; }
</style>
