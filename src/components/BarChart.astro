---
interface Row { name: string; v: number; href?: string; color?: string; note?: string }
interface Props {
  rows: Row[];
  unit?: string;
  max?: number;
  color?: string;
  decimals?: number;
  highlight?: string;
}
const { rows, unit = '', max, color = 'var(--acid)', decimals = 0, highlight } = Astro.props;
const top = max ?? Math.max(...rows.map((r) => r.v));
const fmt = (v: number) => v.toLocaleString('es-ES', { maximumFractionDigits: decimals, minimumFractionDigits: decimals });
---
<div class="bars">
  {rows.map((r, i) => {
    const Tag = r.href ? 'a' : 'div';
    return (
      <Tag href={r.href} class:list={['row', { hl: highlight && r.name === highlight }]} style={`--w:${(r.v / top) * 100}%; --c:${r.color ?? color}; --d:${i * 40}ms`}>
        <span class="n">{r.name}{r.note && <em>{r.note}</em>}</span>
        <span class="track"><span class="fill"></span></span>
        <span class="v">{fmt(r.v)}{unit && <small> {unit}</small>}</span>
      </Tag>
    );
  })}
</div>

<style>
  .bars { display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: minmax(110px, 220px) 1fr 90px;
    gap: 16px;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
  }
  .n { text-transform: uppercase; letter-spacing: 0.06em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .n em { font-style: normal; color: var(--dim); margin-left: 6px; text-transform: none; letter-spacing: 0; }
  .track { height: 14px; background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 10%); position: relative; }
  .fill { position: absolute; inset: 0 auto 0 0; width: var(--w); background: var(--c); animation: grow 0.9s cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--d); }
  .v { text-align: right; font-variant-numeric: tabular-nums; }
  .v small { color: var(--mute); font-size: 10px; }
  a.row:hover .n { color: var(--acid); }
  .hl .n { color: var(--acid); }
  .hl .fill { box-shadow: 0 0 18px var(--c); }
  @keyframes grow { from { width: 0; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr 64px; gap: 4px 10px; } .track { grid-column: 1 / -1; grid-row: 2; } }
</style>
